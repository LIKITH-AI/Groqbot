# Groq API Configuration for chitchat
GROQ_API_KEY=your_groq_api_key_here

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Default Models
# Text: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
DEFAULT_TEXT_MODEL=llama-3.3-70b-versatile

# Vision: llama-3.2-11b-vision-preview, llama-3.2-90b-vision-preview
DEFAULT_VISION_MODEL=llama-3.2-11b-vision-preview

# Audio Transcription: whisper-large-v3, whisper-large-v3-turbo
DEFAULT_AUDIO_MODEL=whisper-large-v3
